      "startClipIndex": 4,
      "endClipIndex": 13,
      "tone": "struggle"
    },
    {
      "id": "ch3",
      "title": "Castillo, Mancini, and a Glimmer of Hope",
      "description": "June produces a parade of big home runs — Castillo's grand slam, Mancini's two-homer game, and Schoop's clutch blast — keeping Baltimore's wild card dream alive despite a 12-16 record.",
      "startClipIndex": 14,
      "endClipIndex": 20,
      "tone": "clutch"
    },
    {
      "id": "ch4",
      "title": "Machado Carries the Load",
      "description": "Manny Machado erupts for a historic stretch in July and August, including two grand slams, powering a surprise 17-12 August and keeping the Orioles in the wild card hunt almost single-handedly.",
      "startClipIndex": 21,
      "endClipIndex": 29,
      "tone": "milestone"
    },
    {
      "id": "ch5",
      "title": "September Collapse",
      "description": "A brutal 7-20 September extinguishes all playoff hopes as the pitching staff crumbles, and even Machado's dramatic late heroics cannot save a season that ultimately ends in disappointment.",
      "startClipIndex": 30,
      "endClipIndex": 33,
      "tone": "struggle"
    }
  ],
