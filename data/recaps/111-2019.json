      "startClipIndex": 13,
      "endClipIndex": 20,
      "tone": "turning_point"
    },
    {
      "id": "ch4",
      "title": "Midsummer Surge",
      "description": "A 15-10 July powered by Chavis's three-run Fourth of July blast and Hernandez's back-to-back homers gives Boston its best stretch of the season.",
      "startClipIndex": 21,
      "endClipIndex": 22,
      "tone": "triumph"
    },
    {
      "id": "ch5",
      "title": "August Fading",
      "description": "Strong individual moments from Bogaerts and Bradley Jr. cannot prevent the pitching staff from surrendering leads, leaving the playoff race precarious entering September.",
      "startClipIndex": 23,
      "endClipIndex": 28,
      "tone": "struggle"
    },
    {
      "id": "ch6",
      "title": "September Collapse",
      "description": "An 11-15 September, punctuated by back-to-back heartbreak losses to Tampa Bay and Texas including a Pujols single and a Santana grand slam, ends Boston's playoff hopes and closes the book on the title defense.",
      "startClipIndex": 29,
      "endClipIndex": 33,
      "tone": "struggle"
