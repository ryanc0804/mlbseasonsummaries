    {
      "id": "ch5",
      "title": "September on Fire",
      "description": "A blistering 21-8 September — fueled by Amed Rosario, Oscar Gonzalez, and clutch performances throughout — cements Cleveland's division title and carries enormous momentum into October.",
      "startClipIndex": 22,
      "endClipIndex": 28,
