    },
    {
      "id": "ch3",
      "title": "June Surge",
      "description": "Cleveland goes 18-10 in June, powered by Naylor's walk-off blast, Oscar Gonzalez's emerging clutch gene, and a string of late-game heroics that establish the Guardians as the AL Central's team to beat.",
      "startClipIndex": 8,
      "endClipIndex": 15,
      "tone": "turning_point"
    },
    {
      "id": "ch4",
      "title": "Grinding Through Summer",
      "description": "July and August bring a mixed bag of wins and losses, but Cleveland's pitching holds the team afloat through a 29-26 stretch as the roster weathers injuries and bullpen volatility.",
      "startClipIndex": 16,
      "endClipIndex": 21,
