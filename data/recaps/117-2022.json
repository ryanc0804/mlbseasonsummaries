    },
    {
      "id": "ch3",
      "title": "Winning Through the Storm",
      "description": "Facing the Yankees in a bruising June-July stretch, Houston takes its lumps from Pressly and the bullpen but keeps winning behind Alvarez, Peña, and a relentless offense.",
      "startClipIndex": 9,
      "endClipIndex": 16,
      "tone": "clutch"
    },
    {
      "id": "ch4",
      "title": "Grinding to the Finish",
      "description": "August and September test the bullpen's reliability and the roster's depth, but grand slams, late-inning rallies, and a 35-19 combined record seal the AL West crown.",
      "startClipIndex": 17,
      "endClipIndex": 26,
      "tone": "triumph"
    },
    {
      "id": "ch5",
